<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.kwin</groupId>
    <artifactId>my-java</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>01-java-basic</module>
        <module>02-ali-oss</module>
        <module>03-ali-oss-x-file-storage</module>
        <module>04-spring-IoC</module>
    </modules>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 1. 引入 Spring Boot 的依赖管理 BOM -->
            <!-- 这样你的所有子模块依然可以享受 Spring Boot 官方统一锁定的依赖版本，不需要自己写版本号 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.2.0</version> <!-- 这里指定你想要的 Spring Boot 版本 -->
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 2. 手动配置 Spring Boot 的 Maven 插件 -->
    <!-- 原本继承 spring-boot-starter-parent 时会自动包含此插件，现在需要手动声明 -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>3.2.0</version> <!-- 版本与上面的 BOM 保持一致 -->
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>